# Copy to .env (git-ignored) and fill in. Everything is optional: with no keys at all, Memora runs fully
# locally (own face model, local safe-zone check, in-app alerts only). See get_api.md for how to get keys.

# --- core ---
MEMORA_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(48))"
# Stored photos and recordings are encrypted with a key derived from MEMORA_SECRET_KEY (or this one, if set).
# Changing the key makes existing files unreadable.
# MEMORA_STORAGE_KEY=
MEMORA_COOKIE_MODE=local      # local | iframe (Hugging Face Space)
# MEMORA_DATA_DIR=./instance

# --- face recognition ---
MEMORA_FACE_PROVIDER=local    # local | cascade (own model, Rekognition only when unsure) | rekognition
MEMORA_FACE_EMBEDDER=sface    # sface | arcface_r34 | w600k_mbf | w600k_r50 (InsightFace: non-commercial)
# Real faces go to Rekognition only after the AWS AI-services opt-out (get_api.md 3f); then set true.
MEMORA_AWS_AI_OPT_OUT_CONFIRMED=false
MEMORA_REKOGNITION_COLLECTION_PREFIX=memora
MEMORA_REKOGNITION_MONTHLY_CAP=900

# --- safe zones ---
MEMORA_GEOFENCE_PROVIDER=local   # local | aws
MEMORA_AWS_GEOFENCE_COLLECTION=memora-safe-zones
MEMORA_AWS_GEOFENCE_MONTHLY_CAP=500

# --- AWS (only for the cascade / aws providers) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# --- Web Push (python scripts/gen_vapid_keys.py) ---
MEMORA_VAPID_PUBLIC_KEY=
MEMORA_VAPID_PRIVATE_KEY=
MEMORA_VAPID_SUBJECT=mailto:you@example.com

# --- speech ---
MEMORA_STT_PROVIDER=whisper   # whisper (on the server) | browser
